PGHOST=localhost
PGPORT=5432
PGDATABASE=barberbook
PGUSER=postgres
PGPASSWORD=your_local_postgres_password
JWT_SECRET=replace_with_a_random_secret
# Keep this stable: changing it requires saving the Telegram bot token again.
TELEGRAM_ENCRYPTION_KEY=replace_with_a_separate_random_secret
# Local development can use 127.0.0.1. Production defaults to 0.0.0.0 so a
# managed host can reach the service; do not override it with 127.0.0.1.
HOST=127.0.0.1
PORT=5000
# In production, list the exact browser origins allowed to call the API.
# Separate multiple origins with commas, for example https://app.mirror.et
CORS_ORIGIN=http://127.0.0.1:5173
# Set TRUST_PROXY=true behind a TLS reverse proxy. Tune these only after
# observing production load.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=600
PGPOOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000
# Set PGSSL=true for managed PostgreSQL providers that require TLS.
PGSSL=false
# Telegram workspace links open this address. Keep the local default while
# running only on this computer; use your public app origin later.
PUBLIC_APP_URL=http://127.0.0.1:5173
# Set this only after the public Mirror domain has wildcard DNS and hosting.
# Example: mirror.et creates sites such as my-salon.mirror.et
PUBLIC_WEBSITE_DOMAIN=
PLATFORM_ADMIN_EMAIL=platform@mirror.local
PLATFORM_ADMIN_PASSWORD=replace_with_a_strong_platform_password
# Optional S3-compatible object storage. When these values are set, uploaded
# profile photos and private subscription receipts leave the VPS disk.
OBJECT_STORAGE_ENDPOINT=https://your-s3-endpoint
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=mirror-uploads
OBJECT_STORAGE_ACCESS_KEY_ID=replace_with_an_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_with_a_secret_key

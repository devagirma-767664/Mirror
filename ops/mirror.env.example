NODE_ENV=production
HOST=0.0.0.0
PORT=5000
TRUST_PROXY=true
PUBLIC_APP_URL=https://mirror.com.et
CORS_ORIGIN=https://mirror.com.et,https://www.mirror.com.et
JWT_SECRET=generate_a_unique_32_character_or_longer_secret
TELEGRAM_ENCRYPTION_KEY=generate_a_separate_32_character_or_longer_secret
PGHOST=your-managed-postgres-host
PGPORT=5432
PGDATABASE=mirror_db
PGUSER=your_database_user
PGPASSWORD=your_database_password
PGSSL=false
RATE_LIMIT_PER_MINUTE=600
PGPOOL_MAX=8
PG_STATEMENT_TIMEOUT_MS=15000
PG_LOCK_TIMEOUT_MS=5000
OBJECT_STORAGE_ENDPOINT=https://your-s3-endpoint
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=mirror-uploads
OBJECT_STORAGE_ACCESS_KEY_ID=your_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_secret_key

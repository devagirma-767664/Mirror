FROM node:22-bookworm-slim

WORKDIR /app

# The frontend is built before this image is transferred to the Nano VPS. This
# keeps the production build below the VPS's 1 GB memory ceiling.
COPY backend/package*.json ./backend/
RUN npm --prefix backend ci --omit=dev

COPY backend ./backend
COPY frontend/dist ./frontend/dist

ENV NODE_ENV=production HOST=0.0.0.0 PORT=5010

USER node
EXPOSE 5010

CMD ["node", "-e", "require('./backend/server').listen(process.env.PORT || 5010, '0.0.0.0')"]
